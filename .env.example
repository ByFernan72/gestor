# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env para personalizar la configuracion del proyecto.
# ==============================================================================

# --- APLICACION Y SERVIDOR ---
# Nombre de la aplicacion Spring Boot
APP_NAME=gestor

# Puerto HTTP en el que corre el backend (por defecto 8080)
SERVER_PORT=8080

# --- BASE DE DATOS (H2 Persistente Local) ---
# URL de conexion JDBC a la base de datos local H2.
# Guarda los datos en disco en un archivo .mv.db dentro de ./data/gestordb
# (Electron configura automaticamente esta ruta en AppData del usuario si no se especifica)
DB_URL=jdbc:h2:file:./data/gestordb;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE

# Driver JDBC de H2
DB_DRIVER=org.h2.Driver

# Usuario por defecto de H2 (System Administrator)
DB_USERNAME=admin

# Password de la base de datos local (vacio por defecto)
DB_PASSWORD=admin

# --- JPA / HIBERNATE ---
# Dialecto SQL utilizado por Hibernate para generar las sentencias compatibles con H2
JPA_DIALECT=org.hibernate.dialect.H2Dialect

# Gestion automatica del esquema de base de datos:
# - update: crea tablas nuevas o agrega columnas sin borrar datos (recomendado)
# - none: no modifica la base de datos
# - create: recrea las tablas borrando datos existentes al reiniciar
JPA_DDL_AUTO=update

# Mostrar las consultas SQL en la consola (true para depurar en desarrollo, false para produccion)
JPA_SHOW_SQL=false

# --- CONSOLA WEB DE H2 ---
# Habilitar la consola web integrada de H2 para inspeccionar tablas desde el navegador
H2_CONSOLE_ENABLED=true

# Ruta web de acceso a la consola H2 (http://localhost:8080/h2-console)
H2_CONSOLE_PATH=/h2-console

# Permitir conexiones remotas a la consola H2 (false por seguridad, solo accesible desde localhost)
H2_CONSOLE_ALLOW_OTHERS=false
